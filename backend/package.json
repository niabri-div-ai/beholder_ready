{
  "name": "backend",
  "version": "1.0.0",
  "description": "Beholder backend",
  "main": "server.js",
  "scripts": {
    "start": "node -r dotenv/config ./src/server",
    "dev": "npx nodemon --trace-warnings -r dotenv/config ./src/server",
    "createdb": "npx sequelize-cli db:create",
    "migratedb": "npx sequelize-cli db:migrate",
    "seeddb": "npx sequelize-cli db:seed:all",
    "build": "npm i && npm run migratedb && npm run seeddb"
  },
  "keywords": [],
  "author": "LuizTools",
  "license": "MIT",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "aes-js": "^3.1.2",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",

    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "mysql2": "^3.15.2",
    "node-binance-api": "github:luiztools/node-binance-api",
    "node-schedule": "^2.1.1",
    "sequelize": "^6.37.7",
    "technicalindicators": "^3.1.0",
    "telegraf": "^4.15.3",
    "twilio": "^5.10.3",
    "winston": "^3.18.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.3"
  }
}
